# Copy this file to .env and fill in the values. .env is git-ignored.

# --- Gemini (used from Phase 2: reply drafts + Gemini-only fallback) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Gemini 3 Flash models can't turn thinking off: low / medium / high (thinking tokens are billed as output)
GEMINI_THINKING_LEVEL=low
# USD per 1M tokens, from ai.google.dev/gemini-api/docs/pricing (gemini-3.8-flash, valid through 2026-12-31)
GEMINI_INPUT_PRICE_PER_M=0.75
GEMINI_OUTPUT_PRICE_PER_M=3.75

# --- Laya ---
USE_LAYA=true
LAYA_MODEL=convaiinnovations/laya
# Leave empty to auto-pick (cuda > mps > cpu), or set cpu / cuda
LAYA_DEVICE=
# Ticket text is truncated to this many tokens before calling Laya (each question has ~320 tokens of room)
MAX_TICKET_TOKENS=300
# Stops transformers probing for TensorFlow, which can make laya.load() hang
USE_TF=0
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# --- Routing thresholds ---
# Top department probability below this -> general_triage queue
MIN_CONFIDENCE=0.5
# Top department probability at or above this -> auto-assign (in between -> "review")
AUTO_CONFIDENCE=0.8
# P(yes) at or above this counts as "yes" for human_needed / standard_reply
NOUL_THRESHOLD=0.5
# P(yes) at or above this counts as a policy violation (tune in the benchmark)
POLICY_THRESHOLD=0.5

# Load Laya when the API starts (set false to start fast when testing only the Gemini path)
PRELOAD_LAYA=true

# --- API ---
DATABASE_URL=sqlite:///./tickets.db
# Comma-separated origins allowed to call the API (the Vite dev server in Phase 3)
CORS_ORIGINS=http://localhost:5173
